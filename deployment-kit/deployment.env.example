# Copy to deployment-kit/deployment.env when you need a local override.
# For the one-shot Codex flow, ZONE_NAME is the only required user input.
# Never commit this file after adding ADMIN_PASSWORD or JWT_SECRET.

# Optional advanced overrides. The script discovers these automatically.
CLOUDFLARE_ACCOUNT_ID=
CF_ZONE_ID=

# Required: the active Cloudflare root zone, for example example.com.
ZONE_NAME=

# Leave resource and subdomain names blank to derive deterministic names from ZONE_NAME.
WORKER_NAME=
D1_NAME=
# Leave blank for a first deployment; fill the created UUID when re-running.
D1_ID=
API_DOMAIN=
MAIL_DOMAIN=

SOURCE_REPO=https://github.com/dreamhunter2333/cloudflare_temp_email.git
SOURCE_REF=v1.11.1
SOURCE_CACHE_DIR=.cache/cloudflare_temp_email

# Leave blank to let the deploy script generate a random admin password.
# The generated password is shown once in the successful deployment summary
# and kept only in a local ignored state file for the verification script.
ADMIN_PASSWORD=
JWT_SECRET=

# Keep automatic Email Routing enabled. The script onboards MAIL_DOMAIN and
# configures Catch-all only when the target Zone is still unconfigured.
ENABLE_EMAIL_ROUTING=1
EMAIL_ROUTING_READY=0
AUTO_EMAIL_ROUTING=1

DEPLOY_FRONTEND=1
FRONTEND_BUILD_COMMAND=build:pages
SKIP_SCHEMA=0
SKIP_SECRETS=0
